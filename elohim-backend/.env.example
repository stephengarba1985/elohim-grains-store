# Copy this file to .env only for local development. Never commit a real .env file.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://local_user:local_password@localhost:5432/elohim_grains
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000

# Production database TLS (set these in the deployment environment, not here).
# DB_SSL_CA=provider-ca-certificate-with-newlines-escaped-as-\\n
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=10000

# Payment and mail provider credentials belong only in deployment secrets.
# PAYSTACK_SECRET_KEY=
# BREVO_API_KEY=
